# Copy to account-security.env; provided startup scripts load it. Direct java -jar does not.
ZK_QUORUM=127.0.0.1

# Required: generate at least 32 random bytes, then encode as a string; keep the same value across restarts.
JWT_SECRET=

# First creation only. Demonstration default explicitly requested by the owner.
ADMIN_INITIAL_PASSWORD=123456

# QQ Mail: enable SMTP in the mailbox settings and use its authorization code.
# Literal KEY=value format, no quotes or shell expansion. Environment variables take precedence.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=false
SMTP_SSL=true
