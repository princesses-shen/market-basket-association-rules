# ============================================================
# 本机私有配置 —— 模板
# ------------------------------------------------------------
# 用法：把本文件复制为同目录下的 local.env，填入你自己的真实值。
#       local.env 已在 .gitignore 中，不会被提交到版本库。
#       代码（config.py）与启动脚本（start_website.bat）都从这里读数，
#       所以仓库里不含任何真实的服务器地址与密码。
#
# 注意：注释请独占一行；值后面不要再跟 "# 注释"，
#       批处理的 for /f 解析会把注释也当成值的一部分。
# ============================================================

# ---- 虚拟机 / 服务器（跑 Hadoop + HBase + Spring Boot 的那台）----
# 注意：本文件是 CRLF 行尾，复制成 local.env 后请保持 CRLF —— start_website.bat 要逐行解析它。
VM_HOST=192.168.1.100
VM_SSH_USER=your-user

# ---- HBase Thrift 服务 ----
HBASE_HOST=192.168.1.100
HBASE_PORT=9090

# ---- SSH 密码 ----
# 仅 scripts/deploy.py 走密码登录时用到；如果已配置 SSH 密钥免密，留空即可。
VM_SSH_PASSWORD=
